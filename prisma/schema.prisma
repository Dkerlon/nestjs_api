generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User{
  id String @id @default(uuid())
  name String
  email String @unique
  password String
  avatar String?
  role Role @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdProjects Project[] @relation("UserToProject")
  tasksAssigned Task[] @relation("AssignedTasks")
  comments Comment[] @relation("commentsUser")
  collaborations ProjectColaborator[] @relation("UserToColaborator")
}

model Project {
  id String@id @default(uuid())
  name String
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdById String

  createdBy User @relation( "UserToProject", fields:[createdById], references: [id])
  tasks Task[] @relation("ProjectToTask")
  collaborators ProjectColaborator[] @relation("ProjectToColaborator")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id String@id @default(uuid())
  title String
  description String?
  status TaskStatus @default(TODO)
  priority TaskPriority @default(MEDIUM)
  dueDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  projectId String
  assignedId String?

  project Project @relation("ProjectToTask", fields:[projectId], references: [id])
  assignee User? @relation("AssignedTasks", fields:[assignedId], references: [id])
  comments Comment[] @relation("taskComments")
}

model Comment {
  id String @id @default(uuid())
  content String
  authorId String
  taskId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation("commentsUser" ,fields:[authorId], references: [id])
  task Task @relation("taskComments" ,fields:[taskId], references: [id])
}

enum CollaboratorRole {
  VIEWER
  EDITOR
  OWNER
}

model ProjectColaborator {
  id String @id @default(uuid())
  role CollaboratorRole @default(EDITOR)
  projectId String
  userId String

  project Project @relation("ProjectToColaborator", fields:[projectId], references: [id])
  user User @relation("UserToColaborator", fields:[userId], references: [id])

  @@unique([userId, projectId])
}
